---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Roger Antonell" noindex>
  <main class="not-found">
    <h1>Page not found</h1>
    <p>This page does not exist. <a href="/">Back to the home page</a>.</p>
  </main>
</Base>

<style>
  .not-found {
    max-width: 67.5rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 6vw, 4rem);
    border: 1px solid var(--line);
  }

  h1 {
    font-size: var(--text-2xl);
    line-height: 1.12;
  }

  p {
    margin-top: var(--space-4);
    color: var(--muted);
  }

  a {
    text-underline-offset: 4px;
  }
</style>
