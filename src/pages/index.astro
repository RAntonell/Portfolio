---
import Hero from '../components/Hero.astro';
import Item from '../components/Item.astro';
import Periods from '../components/Periods.astro';
import Section from '../components/Section.astro';
import WorkList from '../components/WorkList.astro';
import { education, experience, profile, skills } from '../data/resume';
import Base from '../layouts/Base.astro';
import { getWork } from '../lib/work';

const work = await getWork();
---

<Base>
  <div class="page">
    <main>
      <Hero />

      {
        work.length > 0 && (
          <Section id="work" title="Work">
            <WorkList entries={work} />
          </Section>
        )
      }

      <Section id="experience" title="Experience">
        {
          experience.map(({ company, url, title, periods, description }) => (
            <Item>
              <Fragment slot="title">
                <a href={url}>{company}</a>, {title}
              </Fragment>
              <Periods slot="meta" periods={periods} />
              {description}
            </Item>
          ))
        }
      </Section>

      <Section id="skills" title="Skills">
        <div class="skills">
          {skills.map(({ title, items }) => <Item title={title}>{items.join(', ')}</Item>)}
        </div>
      </Section>

      <Section id="education" title="Education">
        <Item title={education.title}>
          <Fragment slot="meta">
            {education.place}, <Periods periods={education.periods} />
          </Fragment>
        </Item>
      </Section>
    </main>

    <footer class="muted screen-only">
      <a href={profile.source}>Source on GitHub</a>
    </footer>
  </div>
</Base>

<style>
  footer {
    margin-top: var(--gap-section);
  }

  @media print {
    .skills :global(.item) {
      display: flex;
      gap: 0.5ch;
    }

    .skills :global(.item + .item) {
      margin-top: var(--gap-tight);
    }

    .skills :global(h3::after) {
      content: ':';
    }

    .skills :global(.body) {
      margin-top: 0;
    }
  }
</style>
