---
import Hero from '../components/Hero.astro';
import Item from '../components/Item.astro';
import Periods from '../components/Periods.astro';
import Section from '../components/Section.astro';
import WorkList from '../components/WorkList.astro';
import { education, experience, profile, skills } from '../data/resume';
import Base from '../layouts/Base.astro';
import { getWork } from '../lib/work';

const work = await getWork();
const caseStudyLinks = (ids: string[] = []) =>
  work
    .filter(({ id }) => ids.includes(id))
    .map(({ id }) => {
      const url = new URL(`/work/${id}/`, Astro.site);
      return { href: url.href, text: `${url.host.replace(/^www\./, '')}${url.pathname.replace(/\/$/, '')}` };
    });
const printTitle = `${profile.name.replaceAll(' ', '-')}-CV`;
---

<Base>
  <div class="page">
    <main>
      <Hero />

      {
        work.length > 0 && (
          <Section id="work" title="Work" class="screen-only">
            <WorkList entries={work} />
          </Section>
        )
      }

      <Section id="experience" title="Experience">
        {
          experience.map(({ company, url, title, periods, description, work: ids }) => (
            <Item>
              <Fragment slot="title">
                <a class="company" href={url}>{company}</a>, {title}
              </Fragment>
              <Periods slot="meta" periods={periods} />
              {description}
              {caseStudyLinks(ids).length > 0 && (
                <span class="print-only">
                  {' Case studies: '}
                  {caseStudyLinks(ids).map(({ href, text }, index) => (
                    <>
                      {index > 0 && ' and '}
                      <a href={href}>{text}</a>
                    </>
                  ))}
                  {'.'}
                </span>
              )}
            </Item>
          ))
        }
      </Section>

      <Section id="skills" title="Skills">
        <div class="skills">
          {skills.map(({ title, items }) => <Item title={title}>{items.join(', ')}</Item>)}
        </div>
      </Section>

      <Section id="education" title="Education">
        <Item title={education.title}>
          <Fragment slot="meta">
            {education.place}, <Periods periods={education.periods} />
          </Fragment>
        </Item>
      </Section>
    </main>

    <footer class="muted screen-only">
      <a href={profile.source}>Source on GitHub</a>
    </footer>
  </div>
  <script is:inline define:vars={{ printTitle }}>
    const screenTitle = document.title;
    addEventListener('beforeprint', () => (document.title = printTitle));
    addEventListener('afterprint', () => (document.title = screenTitle));
  </script>
</Base>

<style>
  footer {
    margin-top: var(--gap-section);
  }

  .skills {
    --item-gap: var(--gap-text);
  }

  @media print {
    .company {
      text-decoration: none;
    }

    .skills :global(.item) {
      display: flex;
      gap: 0.5ch;
    }

    .skills {
      --item-gap: var(--gap-tight);
    }

    .skills :global(h3::after) {
      content: ':';
    }

    .skills :global(.body) {
      margin-top: 0;
    }
  }
</style>
