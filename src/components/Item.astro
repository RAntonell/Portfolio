---
interface Props {
  title: string;
  level?: 2 | 3;
  link?: { href: string; label: string };
}

const { title, level = 3, link } = Astro.props;
const Heading = `h${level}` as const;
const printUrl = link && new URL(link.href, Astro.site).href;
---

<div class="item">
  <Heading>{title}</Heading>
  {
    Astro.slots.has('meta') && (
      <p class="muted">
        <slot name="meta" />
      </p>
    )
  }
  {
    Astro.slots.has('default') && (
      <p class="body">
        <slot />
      </p>
    )
  }
  {
    link && (
      <p class="body">
        <a href={link.href} data-print-url={printUrl}>
          {link.label}
          <span class="visually-hidden">: {title}</span>
        </a>
      </p>
    )
  }
</div>

<style>
  .item + .item {
    margin-top: var(--gap-block);
  }

  .body {
    margin-top: var(--gap-tight);
  }

  @media print {
    .item {
      break-inside: avoid;
    }

    a[data-print-url]::after {
      content: ' (' attr(data-print-url) ')';
    }
  }
</style>
