---
interface Props {
  title?: string;
  level?: 2 | 3;
  href?: string;
}

const { title, level = 3, href } = Astro.props;
const Heading = `h${level}` as const;
const printUrl = href && new URL(href, Astro.site).href;
---

<div class:list={['item', { linked: href }]}>
  <Heading>
    {
      Astro.slots.has('title') ? (
        <slot name="title" />
      ) : href ? (
        <a href={href} data-print-url={printUrl}>
          {title}
        </a>
      ) : (
        title
      )
    }
  </Heading>
  {
    Astro.slots.has('meta') && (
      <p class="muted">
        <slot name="meta" />
      </p>
    )
  }
  {
    Astro.slots.has('default') && (
      <p class="body">
        <slot />
      </p>
    )
  }
</div>

<style>
  .item + .item {
    margin-top: var(--gap-block);
  }

  .body {
    margin-top: var(--gap-tight);
  }

  .linked {
    position: relative;
  }

  .linked a::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--gap-tight));
    border-radius: var(--radius);
  }

  .linked a:focus-visible {
    outline: none;
  }

  .linked a:focus-visible::before {
    outline: 2px solid var(--fg);
  }

  @media print {
    .item {
      break-inside: avoid;
    }

    .linked a::before {
      content: none;
    }

    a[data-print-url]::after {
      content: ' (' attr(data-print-url) ')';
      font-weight: var(--weight-regular);
    }
  }
</style>
