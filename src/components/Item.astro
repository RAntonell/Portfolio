---
interface Props {
  title: string;
  link?: { href: string; label: string };
}

const { title, link } = Astro.props;
---

<div class="item">
  <h3>{title}</h3>
  {
    Astro.slots.has('meta') && (
      <p class="muted">
        <slot name="meta" />
      </p>
    )
  }
  {
    Astro.slots.has('default') && (
      <p class="body">
        <slot />
      </p>
    )
  }
  {
    link && (
      <p class="body">
        <a href={link.href}>
          {link.label}
          <span class="visually-hidden">: {title}</span>
        </a>
      </p>
    )
  }
</div>

<style>
  .item + .item {
    margin-top: var(--gap-block);
  }

  .body {
    margin-top: var(--gap-tight);
  }
</style>
