---
interface Props {
  title: string;
  href?: string;
}

const { title, href } = Astro.props;
---

<div class="item">
  <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  {
    Astro.slots.has('meta') && (
      <p class="muted">
        <slot name="meta" />
      </p>
    )
  }
  {
    Astro.slots.has('default') && (
      <p class="body">
        <slot />
      </p>
    )
  }
</div>

<style>
  .item + .item {
    margin-top: var(--gap-block);
  }

  .body {
    margin-top: var(--gap-tight);
  }
</style>
