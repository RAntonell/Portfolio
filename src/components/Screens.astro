---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Screen {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  screens: [Screen, ...Screen[]];
  caption: string;
  priority?: boolean;
}

const { screens, caption, priority = false } = Astro.props;

const count = screens.length;
const gaps = count - 1;
const column = (rowRem: number) => (rowRem - gaps) / count;
const columnRem = (rowRem: number) => `${Number(column(rowRem).toFixed(2))}rem`;
const densities = [1, 1.5, 2];
const layoutWidths = [35, 52].flatMap((row) => densities.map((density) => Math.round(column(row) * 16 * density)));
const widthsFor = (source: number) =>
  [...new Set(layoutWidths.filter((width) => width < source).concat(source))].sort((a, b) => a - b);
const sizes = [
  `(min-width: 64rem) ${columnRem(52)}`,
  `(min-width: 37rem) ${columnRem(35)}`,
  `calc((100vw - ${2 + gaps}rem) / ${count})`,
].join(', ');
---

<figure>
  <div class="screens">
    {screens.map(({ src, alt }) => <Image src={src} alt={alt} sizes={sizes} widths={widthsFor(src.width)} priority={priority} />)}
  </div>
  <figcaption class="muted">{caption}</figcaption>
</figure>

<style>
  .screens {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    align-items: start;
    gap: var(--gap-text);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    outline: 1px solid var(--line);
    outline-offset: -1px;
  }

  figcaption {
    margin-top: var(--gap-tight);
    margin-inline: auto;
  }

  @media screen and (min-width: 64rem) {
    figure {
      margin-inline: calc((var(--measure) - var(--figure-width)) / 2);
    }
  }
</style>
