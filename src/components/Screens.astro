---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { blurredPlaceholder } from '../lib/placeholder';

interface Screen {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  screens: [Screen, ...Screen[]];
  caption: string;
  priority?: boolean;
}

const { screens, caption, priority = false } = Astro.props;

const count = screens.length;
const stacked = count > 1;
const stackedRem = 18;
const gaps = count - 1;
const column = (rowRem: number) => (rowRem - gaps) / count;
const columnRem = (rowRem: number) => `${Number(column(rowRem).toFixed(2))}rem`;
const densities = [1, 1.5, 2];
const layoutRems = [column(35), column(52), ...(stacked ? [stackedRem] : [])];
const layoutWidths = layoutRems.flatMap((rem) => densities.map((density) => Math.round(rem * 16 * density)));
const widthsFor = (source: number) =>
  [...new Set(layoutWidths.filter((width) => width < source).concat(source))].sort((a, b) => a - b);
const sizes = [
  `(min-width: 64rem) ${columnRem(52)}`,
  `(min-width: 37rem) ${columnRem(35)}`,
  stacked ? `min(calc(100vw - 2rem), ${stackedRem}rem)` : 'calc(100vw - 2rem)',
].join(', ');
const placeholders = await Promise.all(screens.map(({ src }) => blurredPlaceholder(src)));
---

<figure>
  <div class:list={['screens', { stacked }]} style={{ '--stacked-width': `${stackedRem}rem` }}>
    {
      screens.map(({ src, alt }, index) => (
        <Image
          src={src}
          alt={alt}
          sizes={sizes}
          widths={widthsFor(src.width)}
          priority={priority}
          style={{ backgroundImage: placeholders[index] }}
        />
      ))
    }
  </div>
  <figcaption class="muted">{caption}</figcaption>
</figure>

<style>
  .screens {
    display: grid;
    gap: var(--gap-text);
  }

  .stacked {
    justify-items: center;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    outline: 1px solid var(--line);
    outline-offset: -1px;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .stacked img {
    width: min(100%, var(--stacked-width));
  }

  @media (min-width: 37rem) {
    .screens {
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
      align-items: start;
    }

    .stacked img {
      width: 100%;
    }
  }

  figcaption {
    margin-top: var(--gap-tight);
    margin-inline: auto;
  }

  @media screen and (min-width: 64rem) {
    figure {
      margin-inline: calc((var(--measure) - var(--figure-width)) / 2);
    }
  }
</style>
