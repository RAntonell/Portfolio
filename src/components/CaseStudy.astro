---
import { type CollectionEntry, render } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, company, role, period, glance, draft } = entry.data;
const { Content } = await render(entry);
---

<header>
  <h1>{title}</h1>
  <p class="muted">
    {company}, {role}, {period}
    {draft && ' (draft)'}
  </p>
</header>

<dl class="glance">
  {
    glance.map(({ label, value }) => (
      <div>
        <dt class="muted">{label}</dt>
        <dd>{value}</dd>
      </div>
    ))
  }
</dl>

<article class="prose">
  <Content />
</article>

<style>
  header p {
    margin-top: var(--gap-tight);
  }

  .glance {
    display: grid;
    gap: var(--gap-text);
    margin-top: var(--gap-block);
  }

  @media (min-width: 40rem) {
    .glance > div {
      display: grid;
      grid-template-columns: 9rem 1fr;
      gap: var(--gap-text);
    }
  }

  .prose {
    --figure-width: 52rem;

    margin-top: var(--gap-section);
  }

  .prose > :global(* + *) {
    margin-top: var(--gap-text);
  }

  .prose > :global(h2) {
    margin-top: var(--gap-section);
    color: var(--muted);
    font-weight: var(--weight-regular);
  }

  .prose > :global(h3) {
    margin-top: var(--gap-block);
  }

  .prose > :global(h2 + *) {
    margin-top: var(--gap-text);
  }

  .prose > :global(h3 + *) {
    margin-top: var(--gap-tight);
  }

  .prose > :global(:is(ul, ol)) {
    display: grid;
    gap: var(--gap-tight);
    padding-inline-start: 1.5rem;
  }

  .prose > :global(ul) {
    list-style: disc;
  }

  .prose > :global(ol) {
    list-style: decimal;
  }

  .prose > :global(:is(ul, ol) > li::marker) {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .prose > :global(:not(h2, h3) + figure),
  .prose > :global(figure + :not(h2)) {
    margin-top: var(--gap-block);
  }
</style>
