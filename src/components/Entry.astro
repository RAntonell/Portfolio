---
import type { Entry } from '../data/resume';
import Periods from './Periods.astro';

interface Props {
  entry: Entry;
}

const { title, subtitle, periods, location, description } = Astro.props.entry;
---

<article class="entry">
  <h3 class="entry-title">
    {title}
    {subtitle && <span class="entry-subtitle">{subtitle}</span>}
  </h3>
  <p class="entry-meta">
    <Periods periods={periods} />
    {location && <span class="entry-location">{location}</span>}
  </p>
  <p class="entry-description">{description}</p>
</article>

<style>
  .entry + .entry {
    margin-top: var(--space-6);
  }

  .entry-title {
    font-size: var(--text-base);
    line-height: 1.375;
  }

  .entry-subtitle {
    color: var(--muted);
    font-weight: 400;
  }

  .entry-subtitle::before,
  .entry-location::before {
    content: '·';
    margin-inline: 0.5em;
    color: var(--muted);
  }

  .entry-meta {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    line-height: 1.43;
    color: var(--muted);
  }

  .entry-description {
    margin-top: var(--space-2);
    color: var(--muted);
  }
</style>
