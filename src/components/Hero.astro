---
import { profile } from '../data/resume';
import { getWork } from '../lib/work';

const workIds = new Set((await getWork()).map(({ id }) => id));
---

<header>
  <p><strong>{profile.name}</strong></p>
  <h1>{profile.headline}</h1>
  <div class="intro">
    {
      profile.intro.map((paragraph) => (
        <p>
          {paragraph.map((segment) =>
            typeof segment === 'string' ? (
              segment
            ) : workIds.has(segment.work) ? (
              <a href={`/work/${segment.work}/`}>{segment.text}</a>
            ) : (
              segment.text
            ),
          )}
        </p>
      ))
    }
  </div>
  <ul class="links">
    <li class="print-only">{profile.location}, working remotely</li>
    <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    <li class="print-only"><a href={new URL('/', Astro.site).href}>Portfolio</a></li>
    {
      profile.links.map(({ label, href }) => (
        <li>
          <a href={href} rel="me">
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<style>
  h1 {
    margin-top: var(--gap-text);
  }

  .intro {
    display: grid;
    gap: var(--gap-text);
    margin-top: var(--gap-block);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-tight) var(--gap-text);
    margin-top: var(--gap-block);
  }

  .links a {
    display: inline-block;
    overflow-wrap: anywhere;
  }

  @media print {
    .intro a {
      text-decoration: none;
    }

    .links {
      display: grid;
    }

    .links a[href^='http']::after {
      content: ' (' attr(href) ')';
    }
  }
</style>
